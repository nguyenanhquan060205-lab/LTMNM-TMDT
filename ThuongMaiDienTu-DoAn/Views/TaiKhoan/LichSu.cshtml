@model IEnumerable<ThuongMaiDienTu_DoAn.Models.LichSuViewModel>

@{
    ViewBag.Title = "Lịch sử mua hàng";

    // Hàm kiểm tra hủy (không còn lỗi Unicode)
    Func<string, bool> IsHuy = (t) =>
    {
        if (string.IsNullOrWhiteSpace(t)) return false;
        return t.Trim().Equals("Đã Huỷ", StringComparison.OrdinalIgnoreCase);
    };

    // Kiểm tra đã thanh toán
    Func<string, bool> IsThanhToan = (t) =>
    {
        if (string.IsNullOrWhiteSpace(t)) return false;
        return t.Trim().Equals("Đã thanh toán", StringComparison.OrdinalIgnoreCase);
    };
}

<div class="container mt-4">
    <h2 class="mb-3"><i class="bi bi-clock-history"></i> Lịch sử mua hàng</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Ngày đặt</th>
                    <th>Ngày thanh toán</th>
                    <th>Tình trạng đơn</th>
                    <th>Phương thức thanh toán</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    bool huy = IsHuy(item.TrangThai);
                    bool daTT = IsThanhToan(item.TrangThai);

                    <tr>
                        <td>
                            @(item.NgayDat?.ToString("dd/MM/yyyy") ?? "-")
                        </td>

                        <td>
                            @(item.NgayTT?.ToString("dd/MM/yyyy") ?? "-")
                        </td>

                        <td>
                            @if (huy)
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                            else if (daTT)
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else if (item.TrangThai == "Đang chờ xử lý")
                            {
                                <span class="badge bg-warning text-dark">Đang chờ xử lý</span>
                                <div><small class="text-muted">Chờ người bán xác nhận đủ</small></div>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.TrangThai</span>
                            }
                        </td>

                        <td>@item.PhuongThucTT</td>

                        <td>
                            <a class="btn btn-primary btn-sm"
                               href="@Url.Action("CT_LichSu", "TaiKhoan", new { id = item.MaHD })">
                                Xem chi tiết
                            </a>

                            @if (!huy && !daTT)
                            {
                                <a href="@Url.Action("HuyDonHang", "TaiKhoan", new { id = item.MaHD })"
                                   class="btn btn-danger btn-sm ms-1"
                                   onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này không?');">
                                    Hủy
                                </a>

                                <a href="@Url.Action("SuaDonHang", "TaiKhoan", new { id = item.MaHD })"
                                   class="btn btn-warning btn-sm ms-1">
                                    Sửa
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
